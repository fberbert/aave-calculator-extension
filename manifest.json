{
  "manifest_version": 3,
  "name": "Aave LTV Calculator",
  "description": "Calculadora de garantia, dívida, LTV, margem de borrow e liquidação para app.aave.com.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://app.aave.com/*",
    "https://api.kucoin.com/*",
    "https://arb1.arbitrum.io/*"
  ],
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.aave.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/walletBridge.js"],
      "matches": ["https://app.aave.com/*"]
    }
  ]
}
